# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the app (used for PayPal return URLs, invite links, MCP docs)
APP_URL=http://localhost:3000
# Long random string used to sign session cookies (openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that get the ops console with full access
ADMIN_EMAILS=
# Shared secret for the external cron hitting /api/cron/sweep (Bearer token)
CRON_SECRET=change-me
# "true" lets visitors spin up an isolated demo world (recommended for judging)
DEMO_MODE=true

# ─── Database (libSQL / SQLite) ──────────────────────────────────────────
# Local file by default. For a persistent hosted DB use Turso: libsql://<db>.turso.io
DATABASE_URL=file:./data/kept.db
DATABASE_AUTH_TOKEN=

# ─── PayPal (sandbox) ────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app.
# Leave empty to run on Kept's built-in PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Webhook ID shown after adding https://<APP_URL>/api/webhooks/paypal as a webhook in your app
PAYPAL_WEBHOOK_ID=
# A sandbox *personal* account email; demo freelancers are paid out here
PAYPAL_DEMO_PAYOUT_EMAIL=
# "true" after enabling "Log in with PayPal" on the app (return URL: <APP_URL>/api/auth/paypal/callback)
PAYPAL_LOGIN_ENABLED=false
PAYPAL_BRAND_NAME=Kept Escrow
# Optional: "v5" to use the classic JS SDK buttons instead of JS SDK v6
PAYPAL_JS_SDK=v6

# ─── AI ──────────────────────────────────────────────────────────────────
# Optional Anthropic provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Gemini developer API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional Vertex AI project. Uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT_FOR_AI=
# Force a provider: anthropic | gemini | offline
AI_PROVIDER=

# Optional GitHub token to raise the API rate limit for repository evidence probes
GITHUB_EVIDENCE_TOKEN=

# Pricing
PLATFORM_FEE_BPS=290
PLATFORM_FEE_MIN_CENTS=100

# Reasoning effort for the referee and mediator: low | medium | high
AI_JUDGE_EFFORT=medium

# Transactional email: configure SMTP or RESEND_API_KEY.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Kept <your-verified-sender@example.com>
RESEND_API_KEY=
